{
  "name": "printroom",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server": "bun run server/index.ts",
    "build": "tsc --noEmit && vite build",
    "test": "bun test",
    "start": "bun run server/index.ts",
    "backup": "bun run scripts/maintenance.ts backup",
    "restore": "bun run scripts/maintenance.ts restore",
    "recover-owner": "bun run scripts/maintenance.ts recover-owner",
    "cleanup-uploads": "bun run scripts/maintenance.ts cleanup-uploads",
    "format": "prettier --write src server shared tests scripts public/sw.js vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src server shared tests scripts public/sw.js vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.0",
    "@astryxdesign/theme-stone": "^0.6.0",
    "@stylexjs/stylex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "^0.19.1",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "bun": "1.4.2"
  }
}
