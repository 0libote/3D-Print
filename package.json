{
  "name": "printroom",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --host 0.0.0.0",
    "server": "bun server/index.ts",
    "build": "bun run typecheck && bun --bun vite build",
    "test": "bun test",
    "start": "bun server/index.ts",
    "backup": "bun run scripts/maintenance.ts backup",
    "restore": "bun run scripts/maintenance.ts restore",
    "recover-owner": "bun run scripts/maintenance.ts recover-owner",
    "cleanup-uploads": "bun run scripts/maintenance.ts cleanup-uploads",
    "format": "prettier --write src server shared tests scripts public/sw.js vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src server shared tests scripts public/sw.js vite.config.ts tsconfig.json package.json",
    "typecheck": "bun --bun tsc --noEmit"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.1",
    "@astryxdesign/theme-stone": "^0.7.1",
    "@stylexjs/stylex": "^0.19.0",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "^0.19.1",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "bun": "1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
